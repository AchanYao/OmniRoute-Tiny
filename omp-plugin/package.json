{
  "name": "omniroute-omp-plugin",
  "version": "0.0.1",
  "description": "Oh My Pi plugin for OmniRoute automatic model discovery, filtering non-chat models, and per-model native provider resolution.",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "omp": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "scripts": {
    "build": "tsc",
    "test": "node --import tsx/esm --test tests/plugin.test.ts"
  },
  "type": "module",
  "license": "MIT",
  "keywords": [
    "omp",
    "oh-my-pi",
    "omniroute",
    "plugin"
  ]
}
