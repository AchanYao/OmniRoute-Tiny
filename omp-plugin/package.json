{
  "name": "omniroute-omp-plugin",
  "version": "0.0.1",
  "description": "Oh My Pi plugin for OmniRoute automatic model discovery, filtering non-chat models, and per-model native provider resolution.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run"
  },
  "omp": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "keywords": [
    "omp",
    "oh-my-pi",
    "omniroute",
    "plugin"
  ],
  "license": "MIT"
}
